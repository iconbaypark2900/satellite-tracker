{
  "compilerOptions": {
    "target": "es2022",
    "lib": ["dom", "dom.iterable", "es2022"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "forceConsistentCasingInFileNames": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "baseUrl": ".",
    "paths": {
      "@/*": ["./*"],
      "@/components/*": ["./components/*"],
      "@/lib/*": ["./lib/*"],
      "@/hooks/*": ["./hooks/*"],
      "@/types/*": ["./types/*"],
      "@/workers/*": ["./workers/*"]
    },
    "types": ["jest", "node"]
  },
  "include": [
    "next.config.mjs",
    "tailwind.config.js",
    "postcss.config.js",
    "middleware.ts",
    "scripts/**/*.ts",
    "workers/**/*.ts",
    "lib/**/*.ts",
    "hooks/**/*.ts",
    "components/**/*.ts",
    "components/**/*.tsx",
    "types/**/*.ts",
    "app/**/*.ts",
    "app/**/*.tsx"
  ],
  "exclude": ["node_modules", ".next", "out", "build"]
}
